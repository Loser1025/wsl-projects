= non_staff[1] if len(non_staff) > 1 else None\n\n    # updateTextStyle: フォント色・サイズを変更\n    # 名前ボックス → 114pt, LIGHT1\n    if name_box:\n        eid = name_box[\'eid\']\n        requests.append({\n            "updateTextStyle": {\n                "objectId": eid,\n                "style": {\n                    "foregroundColor": {\n                        "opaqueColor": {"themeColor": "LIGHT1"}\n                    },\n                    "fontSize": {"magnitude": 114, "unit": "PT"},\n                    "fontFamily": "Arial"\n                },\n                "textRange": {"type": "ALL"},\n                "fields": "foregroundColor,fontSize,fontFamily"\n            }\n        })\n\n    # ローマ字ボックス → 30pt, LIGHT1\n    if romaji_box:\n        eid = romaji_box[\'eid\']\n        requests.append({\n            "updateTextStyle": {\n                "objectId": eid,\n                "style": {\n                    "foregroundColor": {\n                        "opaqueColor": {"themeColor": "LIGHT1"}\n                    },\n                    "fontSize": {"magnitude": 30, "unit": "PT"},\n                    "fontFamily": "Arial"\n                },\n                "textRange": {"type": "ALL"},\n                "fields": "foregroundColor,fontSize,fontFamily"\n            }\n        })\n\nprint(f"合計 {len(requests)} 件のフォント修正リクエスト")\n\n# 実行（50件ずつ）\nfor start in range(0, len(requests), 50):\n    chunk = requests[start:start+50]\n    resp = service.presentations().batchUpdate(\n        presentationId=PRESENTATION_ID,\n        body={"requests": chunk}\n    ).execute()\n    print(f"  {(start//50)+1}/{(len(requests)+49)//50}: {len(resp.get(\'replies\',[]))} 件完了")\n\nprint("\\n✅ 全24名分のフォント修正完了")\n\n# 確認\npres2 = service.presentations().get(presentationId=PRESENTATION_ID).execute()\nfor slide in pres2.get(\'slides\', []):\n    if slide[\'objectId\'] == \'gNEW_0\':\n        print("\\n=== 修正後 スライド0のフォント状態 ===")\n        for el in slide.get(\'pageElements\', []):\n            if \'shape\' not in el or \'text\' not in el[\'shape\']:\n                continue\n            shape = el[\'shape\']\n            eid = el[\'objectId\']\n            for te in shape[\'text\'].get(\'textElements\', []):\n                if \'textRun\' in te:\n                    content = te[\'textRun\'].get(\'content\', \'\')\n                    style = te[\'textRun\'].get(\'style\', {})\n                    if content.strip():\n                        fg = style.get(\'foregroundColor\',{})\n                        opaque = fg.get(\'opaqueColor\',{})\n                        print(f"  eid={eid}, text={content.strip()!r}")\n                        print(f"    size={style.get(\'fontSize\',{})}, family={style.get(\'fontFamily\',\'\')}, theme={opaque.get(\'themeColor\',\'\')}")\n        break\nEOF', 'timeout': 60}}
