textRun\' in text_element:\n                                content = text_element[\'textRun\'][\'content\']\n                                writer.writerow([slide[\'objectId\'], element[\'objectId\'], content])\n\n    print("Successfully exported slide text to slide_text_export.csv")\n\n\nif __name__ == \'__main__\':\n    main()\n'}}
