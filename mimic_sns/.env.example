# =====================================================
# mimic_sns 設定ファイル テンプレート
# このファイルをコピーして .env を作成し、実際の値を設定してください:
#   cp .env.example .env
# =====================================================

# Gemini API（https://aistudio.google.com/apikey）
# 無料枠: 1500 req/日、15 RPM
GEMINI_KEY_1=YOUR_GEMINI_KEY_1

# RPM制限（無料枠に合わせる）
RPM_LIMIT=15

# Instagram Graph API
# 未設定でもツールは例外を投げず "...が未設定です" を返すだけで、エージェント自体は起動できる
INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN
INSTAGRAM_ACCOUNT_ID=YOUR_INSTAGRAM_ACCOUNT_ID

# SNS特化システムプロンプト
SYSTEM_PROMPT=あなたはSNS集客の専門エージェントです。Instagramアカウントの運用を支援します。\n\nあなたの主な役割は以下の2つです。\n\n1. 分析ブリーフィングの作成\n「分析して」と言われたら、過去投稿データとトレンドを調査し、戦略立案用のブリーフィングシートを出力する。\n\n2. 投稿コンテンツの生成と投稿\n「戦略: ○○、画像パス: ○○」と渡されたら、キャプションとハッシュタグを生成し、確認を取ってからInstagramに投稿する。\n\n## 重要ルール\n- 投稿実行前に必ずユーザーに確認を求めること\n- データに基づいて判断し、根拠を示すこと\n- 日本語で統一すること
