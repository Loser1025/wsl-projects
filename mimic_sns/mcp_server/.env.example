# Instagram
INSTAGRAM_ACCESS_TOKEN=your_token_here
INSTAGRAM_ACCOUNT_ID=17841405582880785

# Threads
THREADS_ACCESS_TOKEN=your_token_here
THREADS_USER_ID=27187147597562287

# Meta App Secret（省略可。設定するとInstagram/Threadsトークンの期限が7日を切った際に
# fb_exchange_token/th_exchange_tokenで自動的に長期トークンへ更新する。未設定なら従来通り
# 手動ローテーションが必要）
APP_SECRET=your_app_secret_here

# MCPサーバー自体の認証トークン（Authorization: Bearer <token> で必須）
# 未設定だと全リクエストが401で拒否される
MCP_AUTH_TOKEN=your_random_secret_here
